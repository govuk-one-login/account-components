{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "home",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "code style and linting",
            "secret scanning",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".pre-commit-config.yaml"
          }
        },
        {
          "checkTypes": [
            "unit",
            "new feature",
            "regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yaml",
            "path": "$.jobs.test"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "vulnerability detection",
            "code quality",
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check.yaml",
            "path": "$.jobs.check"
          }
        },
        {
          "checkTypes": [
            "integration",
            "accessibility",
            "regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/integration-test.yaml",
            "path": "$.jobs.integration-test"
          }
        },
        {
          "checkTypes": [
            "integration",
            "accessibility",
            "regression"
          ],
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "config": {
            "file": ".github/workflows/deploy.yaml",
            "path": "$.jobs.publish-integration-tests-image"
          }
        },
        {
          "checkTypes": [
            "code quality",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yaml",
            "path": "$.jobs.sonarcloud"
          }
        },
        {
          "checkTypes": [
            "canary"
          ],
          "phase": "integration",
          "provider": "Stack Orchestration Tool",
          "config": {
            "file": ".github/workflows/deploy.yaml",
            "path": "$.jobs.deploy"
          }
        },
        {
          "checkTypes": [
            "canary"
          ],
          "phase": "production",
          "provider": "Stack Orchestration Tool",
          "config": {
            "file": ".github/workflows/deploy.yaml",
            "path": "$.jobs.deploy"
          }
        },
        {
          "checkTypes": [
            "unit",
            "new feature",
            "regression"
          ],
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yaml",
            "path": "$.jobs.test"
          }
        }
      ]
    }
  ]
}
