{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "One-Login-Home",
      "component": "account-components",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".pre-commit-config.yaml"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yaml",
            "path": "$.jobs.test"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "new feature"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check.yaml",
            "path": "$.jobs.check"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "vulnerability detection"
            },
            {
              "name": "code quality"
            },
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/integration-test.yaml",
            "path": "$.jobs.integration-test"
          },
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "accessibility"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "config": {
            "file": ".github/workflows/deploy.yaml",
            "path": "$.jobs.publish-integration-tests-image"
          },
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "accessibility"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yaml",
            "path": "$.jobs.sonarcloud"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "integration",
          "provider": "Stack Orchestration Tool",
          "config": {
            "file": ".github/workflows/deploy.yaml",
            "path": "$.jobs.deploy"
          },
          "checks": [
            {
              "name": "canary"
            }
          ]
        },
        {
          "phase": "production",
          "provider": "Stack Orchestration Tool",
          "config": {
            "file": ".github/workflows/deploy.yaml",
            "path": "$.jobs.deploy"
          },
          "checks": [
            {
              "name": "canary"
            }
          ]
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yaml",
            "path": "$.jobs.test"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "new feature"
            },
            {
              "name": "regression"
            }
          ]
        }
      ]
    }
  ]
}
