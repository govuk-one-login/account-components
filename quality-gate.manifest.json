{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.18.0/schemas/schema.json",
  "services": [
    {
      "product": "One-Login-Home",
      "component": "account-components",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".pre-commit-config.yaml"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/test.yaml",
          "path": "$.jobs.test"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "vulnerability detection"
            },
            {
              "name": "code quality"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/check.yaml",
          "path": "$.jobs.check"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "accessibility"
            }
          ],
          "file": ".github/workflows/integration-test.yaml",
          "path": "$.jobs.integration-test"
        },
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "accessibility"
            }
          ],
          "file": ".github/workflows/deploy.yaml",
          "path": "$.jobs.publish-integration-tests-image"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/sonarcloud.yaml",
          "path": "$.jobs.sonarcloud"
        },
        {
          "phase": "integration",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "canary"
            }
          ],
          "file": ".github/workflows/deploy.yaml",
          "path": "$.jobs.deploy"
        },
        {
          "phase": "production",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "canary"
            }
          ],
          "file": ".github/workflows/deploy.yaml",
          "path": "$.jobs.deploy"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/test.yaml",
          "path": "$.jobs.test"
        }
      ]
    },
    {
      "product":"One-Login-Home",
      "component": "amc_config",
      "promotionType":"securePipelines",
      "notApplicable": [
        {
          "checks": [
            {"name": "accessibility", "details": ["No UI"]}
          ]
        }
      ]
    }
  ]
}
